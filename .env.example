# Supabase (Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Contas de demonstração (opcional, só para ambiente local)
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_STUDENT_PASSWORD=

# Secrets das Edge Functions (configure no painel do Supabase, NÃO no front-end):
# OPENAI_API_KEY, MERCADO_PAGO_ACCESS_TOKEN, STRIPE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY
